{
  "name": "pdf",
  "main": "index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    { "pattern": "gyorgygutai.dev/*.pdf", "zone_name": "gyorgygutai.dev" }
  ]
}
