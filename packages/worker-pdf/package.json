{
  "name": "@gyorgygutai/pdf-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundleVaultIntoWorker": "tsx src/bundleVaultIntoWorker.ts",
    "dev": "npm run bundleVaultIntoWorker && wrangler dev --config src/wrangler.jsonc",
    "deploy": "npm run bundleVaultIntoWorker && wrangler deploy --config src/wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@gyorgygutai/preset-obsidian-md": "*",
    "@gyorgygutai/collect-vault": "*",
    "@gyorgygutai/processor-pdf": "*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
