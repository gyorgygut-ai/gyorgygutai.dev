{
  "name": "obsidian-vault-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint processor worker",
    "lint:fix": "eslint processor worker --fix",
    "coverage": "vitest run --coverage",
    "bundleVaultIntoWorker": "tsx worker/bundleVaultIntoWorker.ts",
    "dev": "npm run bundleVaultIntoWorker && wrangler dev --config worker/wrangler.jsonc",
    "deploy": "npm run bundleVaultIntoWorker && wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@quartz-community/rehype-obsidian": "^0.1.2",
    "@quartz-community/remark-obsidian": "^0.2.4",
    "gray-matter": "^4.0.3",
    "pdf-lib": "^1.17.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^4.5.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
